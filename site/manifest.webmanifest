  "icons": [
    {"src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"},
    {"src": "./pwa-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ],
  "shortcuts": [
    {"name": "Partidos", "short_name": "Partidos", "url": "./#fixtures", "description": "Próximos partidos"},
    {"name": "Top 3", "short_name": "Top 3", "url": "./#history", "description": "Historial de selecciones verificadas"},
    {"name": "Cuotas reales", "short_name": "Cuotas", "url": "./#realodds", "description": "Precios reales observados"}
  ]
}
