{
  "id": "./",
  "name": "Football AI Lab",
  "short_name": "Football AI",
  "description": "Agenda de fútbol, pronósticos Top 3, radar y cuotas observadas. Datos públicos del laboratorio.",
  "lang": "es-ES",
  "start_url": "./#fixtures",
